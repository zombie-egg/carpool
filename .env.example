# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://carpool_user:your_password@localhost:5432/lian_carpool?schema=public"
# For a future MySQL deployment, set provider = "mysql" in prisma/schema.prisma
# and use this format instead:
# DATABASE_URL="mysql://carpool_user:your_password@localhost:3306/lian_carpool"

# The only account allowed to manage drivers.
ADMIN_EMAIL="admin@example.com"

# Session cookie signing secret. Generate with: openssl rand -hex 32
AUTH_SECRET="replace_with_random_hex"

# SMTP mailbox used to send registration verification codes.
# For QQ Mail: enable SMTP in mailbox settings and use the generated auth code
# (NOT your QQ password) as QQ_EMAIL_AUTH_CODE.
SMTP_HOST="smtp.qq.com"
SMTP_PORT="465"
QQ_EMAIL="your_qq_number@qq.com"
QQ_EMAIL_AUTH_CODE="your_smtp_auth_code"
