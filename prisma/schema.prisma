// Prisma schema for the Li'an Campus Carpool platform.
// Database: PostgreSQL. Run `npx prisma migrate dev --name init` to create tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Current deployment target. For the planned MySQL deployment, change
  // provider to "mysql", point DATABASE_URL at a MySQL instance
  // (mysql://USER:PASSWORD@HOST:3306/lian_carpool) and re-create the
  // migrations directory (`rm -rf prisma/migrations && prisma migrate dev`),
  // since migration SQL is database-specific. All column types used here
  // (@db.Decimal, @db.Date) exist in MySQL as well.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A registered account. Everyone publishes/joins trips with their own account.
model User {
  /// Primary key (collision-resistant cuid).
  id             String            @id @default(cuid())
  /// Login email, unique per account (verified by emailed code at signup).
  email          String?           @unique
  /// scrypt password hash, stored as "saltHex$hashHex".
  passwordHash   String?
  /// Display nickname shown as the trip organizer name by default.
  nickname       String
  /// Profile image: WeChat CDN URL or a user-uploaded image data URL.
  avatarUrl      String?
  /// WeChat Official Account OpenID; present for WeChat-created accounts.
  wechatOpenId   String?           @unique
  /// Persisted role; WeChat admin binding survives nickname changes.
  isAdmin        Boolean           @default(false)
  /// Account role. Existing and unspecified accounts are customers.
  role           String            @default("customer")
  createdAt      DateTime          @default(now())
  trips          CarpoolOrder[]
  participations TripParticipant[]
  driverProfile  DriverInfo?
  driverRequests DriverBookingRequest[] @relation("CustomerDriverRequests")
}

/// Short-lived handoff token used to log a desktop browser in after QR scan.
model WechatLoginTicket {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String?
  status    String   @default("pending")
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// Short-lived profile handoff for first-time WeChat registration.
model WechatRegistrationTicket {
  id              String   @id @default(cuid())
  token           String   @unique
  openId          String
  nickname        String
  avatarUrl       String?
  loginTicket     String?
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@index([expiresAt])
}

/// Merchant information displayed in the public Hotspots section.
model MerchantPromotion {
  id           String   @id @default(cuid())
  merchantName String
  content      String
  poster1      String?
  poster2      String?
  poster3      String?
  poster4      String?
  coverIndex   Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

/// Compact VIP messages rotated beneath the homepage hero title.
model VipAdvertisement {
  id        String   @id @default(cuid())
  title     String
  content   String
  /// Cropped 12:1 banner image stored as a compressed data URL.
  imageData String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Short-lived email verification codes for account registration.
model EmailCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

/// A carpool trip published by a student organizer.
model CarpoolOrder {
  /// Primary key (collision-resistant cuid).
  id             String            @id @default(cuid())
  /// Nickname of the trip organizer shown on the trip card.
  organizerName  String
  /// Departure location (campus preset or custom text).
  departLocation String
  /// Destination location.
  destination    String
  /// Exact departure date and time.
  departTime     DateTime
  /// Total rider capacity, including the organizer.
  totalSeats     Int
  /// Seats still available after counting the organizer; decremented when a passenger joins.
  remainingSeats Int
  /// TOTAL price of the whole trip in RMB; passengers split it, so the
  /// per-person share depends on how many people finally join.
  totalPrice     Decimal           @db.Decimal(10, 2)
  /// Account that published this trip.
  organizerId    String?
  organizer      User?             @relation(fields: [organizerId], references: [id])
  /// Enabled contact channels: "wechat" | "phone" | "both".
  contactType    String
  /// WeChat ID (present when contactType includes wechat).
  wechatId       String?
  /// Phone number (present when contactType includes phone).
  phoneNumber    String?
  /// Optional remarks: luggage limits, pet rules, travel notes.
  remark         String?
  /// Trip status: "recruiting" | "full" | "finished".
  status         String            @default("recruiting")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  participants   TripParticipant[]
  driverRequest  DriverBookingRequest?

  @@index([departTime])
  @@index([status])
}

/// A user's single tracked signup for a trip. One signup may cover a group.
model TripParticipant {
  id           String       @id @default(cuid())
  tripId       String
  userId       String
  partySize    Int
  contactType  String
  contactValue String
  createdAt    DateTime     @default(now())
  trip         CarpoolOrder @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([userId])
}

/// A registered campus driver managed via the Driver Management Center.
model DriverInfo {
  /// Primary key (collision-resistant cuid).
  id                  String   @id @default(cuid())
  /// Registered driver account. Null for legacy records created by an admin.
  userId              String?  @unique
  user                User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Driver full name.
  driverName          String
  /// Driver phone number (required).
  phone               String
  /// Driver WeChat ID (optional).
  wechat              String?
  /// Vehicle license plate number.
  licensePlate        String
  /// First day of the driver's service period (date only).
  operationStartDate  DateTime @db.Date
  /// Last day of the driver's service period (date only).
  operationEndDate    DateTime @db.Date
  /// Daily service window start, stored as "HH:mm" (Prisma has no bare Time scalar).
  dailyAvailableStart String
  /// Daily service window end, stored as "HH:mm".
  dailyAvailableEnd   String
  /// Vehicle type: preset ("sedan" | "suv" | "mpv") or free custom text.
  carType             String
  /// Vehicle color (optional), shown next to the license plate.
  carColor            String?
  /// Optional promotion/discount info shown on the driver card.
  discountInfo        String?
  /// Supplementary notes: trunk space, smoking permission, other reminders.
  carRemark           String?
  createdAt           DateTime @default(now())
  requests            DriverBookingRequest[]

  @@index([operationEndDate])
}

/// A customer's structured inquiry to a driver. Driver confirmation creates a trip.
model DriverBookingRequest {
  id               String       @id @default(cuid())
  customerId       String
  driverId         String
  departLocation   String
  destination      String
  departTime       DateTime
  totalSeats       Int
  estimatedPrice   Decimal      @db.Decimal(10, 2)
  finalPrice       Decimal?     @db.Decimal(10, 2)
  customerContactType  String
  customerContactValue String
  remark           String?
  status           String       @default("pending")
  carpoolOrderId   String?      @unique
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  customer         User         @relation("CustomerDriverRequests", fields: [customerId], references: [id], onDelete: Cascade)
  driver           DriverInfo   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  carpoolOrder     CarpoolOrder? @relation(fields: [carpoolOrderId], references: [id])

  @@index([customerId, createdAt])
  @@index([driverId, status, createdAt])
}
